<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- ########################################################## -->
    <!-- ####################   PARÁMETROS     #################### -->
    <!-- ########################################################## -->

    <xacro:property name="params_path" value="$(find eurobot_software_description)/config/parametros_robot.yaml" />
    <xacro:property name="params" value="${xacro.load_yaml(params_path)}" />

    <!-- Extraer la sección de la cámara -->
    <xacro:property name="act" value="${params['camera']}" />

    <!-- Variables de la cámara -->
    <xacro:property name="cam_offset_x" value="${act['offset_x']}" />
    <xacro:property name="cam_offset_y" value="${act['offset_y']}" />
    <xacro:property name="cam_offset_z" value="${act['offset_z']}" />

    <xacro:property name="cam_pos_x" value="${act['camera_x']}" />
    <xacro:property name="cam_pos_y" value="${act['camera_y']}" />
    <xacro:property name="cam_pos_z" value="${act['camera_z']}" />

    <xacro:property name="cam_fov" value="${act['camera_fov']}" />
    <xacro:property name="image_width" value="${act['image_width']}" />
    <xacro:property name="image_height" value="${act['image_height']}" />
    <xacro:property name="image_format" value="${act['image_format']}" />


    <!-- Posición de la cámara-->
    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <!-- Ajusta la posición para que quede en el frontal superior del robot -->
        <origin xyz="${cam_offset_x} ${cam_offset_y} ${cam_offset_z}" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <geometry><box size="${cam_pos_x} ${cam_pos_y} ${cam_pos_z}"/></geometry>
            <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
    </link>

    <!-- Corrección del sistema de coordenadas para OpenCV (OpenCV tiene el eje Z apuntando hacia adelante y X a la derecha)-->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    <!-- Lo giramos para corregir la orientación -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="camera_link_optical"></link>

    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>camera/image_raw</topic>
            <!-- Vincular los datos al frame corregido, no al físico -->
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>